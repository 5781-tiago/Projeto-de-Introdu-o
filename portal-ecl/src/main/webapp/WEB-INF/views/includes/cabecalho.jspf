<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${titulo}" /> | Portal ECL — Serviços</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilo.css">
</head>
<body>
<header class="topo">
    <div class="contentor topo-conteudo">
        <a class="marca" href="${pageContext.request.contextPath}/inicio">
            <img class="marca-logo" src="${pageContext.request.contextPath}/img/logo-ecl.png" alt="Escola de Comércio de Lisboa">
            <span class="marca-nome">Portal de<br>Serviços</span>
        </a>
        <input type="checkbox" id="menu-abrir" class="menu-abrir" aria-label="Abrir menu">
        <label for="menu-abrir" class="menu-botao">Menu</label>
        <nav class="menu">
            <a href="${pageContext.request.contextPath}/inicio" class="${menu eq 'inicio' ? 'ativo' : ''}">Início</a>
            <a href="${pageContext.request.contextPath}/cursos" class="${menu eq 'cursos' ? 'ativo' : ''}">Oferta formativa</a>
            <a href="${pageContext.request.contextPath}/pre-inscricao" class="${menu eq 'pre-inscricao' ? 'ativo' : ''}">Pré-inscrição</a>
            <a href="${pageContext.request.contextPath}/avarias" class="${menu eq 'avarias' ? 'ativo' : ''}">Reportar avaria</a>
            <a href="${pageContext.request.contextPath}/gestao" class="${menu eq 'gestao' ? 'ativo' : ''}">Área reservada</a>
        </nav>
    </div>
</header>
<main class="contentor">
